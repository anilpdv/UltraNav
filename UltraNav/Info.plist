<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>UltraNav</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>UltraNav uses your location while you navigate to calculate cycling routes, show your position, and provide turn-by-turn guidance.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>UltraNav connects to Bluetooth cycling power meters, cadence sensors, and heart rate monitors.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>UltraNav reads heart rate and cycling metrics during workouts.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>UltraNav saves your cycling workouts and routes to Apple Health.</string>
	<key>WKBackgroundModes</key>
	<array>
		<string>location</string>
		<string>workout-processing</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKWatchOnly</key>
	<true/>
</dict>
</plist>
